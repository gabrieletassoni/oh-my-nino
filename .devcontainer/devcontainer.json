{
  "name": "oh-my-nino-dev",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install pyyaml",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "davidanson.vscode-markdownlint",
        "yzhang.markdown-all-in-one",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "files.insertFinalNewline": true,
        "editor.rulers": [
          100
        ]
      }
    }
  }
}
