{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Skill: package",
      "type": "shell",
      "command": "python",
      "args": [
        "scripts/package_skill.py",
        "oh-my-nino",
        "dist"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Skill: clean and package",
      "type": "shell",
      "command": "sh",
      "args": [
        "-c",
        "rm -f dist/oh-my-nino.skill && python scripts/package_skill.py oh-my-nino dist"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
